#!/bin/sh
set -e

# /etc/pve-klp/pve-klp.toml belongs to the administrator (and to
# `pve-klp setup`). It is deliberately not a dpkg conffile: package upgrades
# never touch it and never prompt. Versions up to 0.1.3 shipped it as a
# conffile; dpkg keeps such a file in place when a new version drops it.
if [ "$1" = "configure" ] && [ ! -e /etc/pve-klp/pve-klp.toml ]; then
	install -d -m 0755 /etc/pve-klp
	install -m 0644 /usr/share/pve-klp/pve-klp.toml /etc/pve-klp/pve-klp.toml
fi

#DEBHELPER#
