#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
	rm -f /etc/hvpatch/hvpatch.toml
	rm -rf /var/lib/hvpatch
	rm -f /var/lib/prometheus/node-exporter/hvpatch.prom
	# Trusted keys and hooks are the administrator's files; keep them.
	rmdir --ignore-fail-on-non-empty /etc/hvpatch/trusted.d /etc/hvpatch/hooks.d /etc/hvpatch 2>/dev/null || true
fi
#DEBHELPER#
