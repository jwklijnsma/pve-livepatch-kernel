#!/bin/sh
set -e
if [ "$1" = "purge" ]; then
	rm -f /etc/pve-klp/pve-klp.toml
	rm -rf /var/lib/pve-klp
	rm -f /var/lib/prometheus/node-exporter/pve_klp.prom
	# Trusted keys and hooks are the administrator's files; keep them.
	rmdir --ignore-fail-on-non-empty /etc/pve-klp/trusted.d /etc/pve-klp/hooks.d /etc/pve-klp 2>/dev/null || true
fi
#DEBHELPER#
