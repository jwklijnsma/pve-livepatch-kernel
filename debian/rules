#!/usr/bin/make -f

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/debian/.cargo
export CARGO_TARGET_DIR = $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked -p pve-klp

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --locked -p klp-core -p pve-klp
endif

override_dh_auto_install:
	# handled by debian/pve-klp.install

override_dh_auto_clean:
	rm -rf debian/.cargo

override_dh_installsystemd:
	dh_installsystemd pve-klp-boot.service
	dh_installsystemd --no-enable --no-start pve-klp-auto.timer pve-klp-auto.service
