#!/usr/bin/make -f

export DH_VERBOSE = 1
export CARGO_HOME = $(CURDIR)/debian/.cargo
export CARGO_TARGET_DIR = $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked -p hvpatch
	mkdir -p target/completions
	target/release/hvpatch completions bash > target/completions/hvpatch

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --locked -p klp-core -p hvpatch
endif

override_dh_auto_install:
	# handled by debian/hvpatch.install

override_dh_auto_clean:
	rm -rf debian/.cargo

override_dh_installsystemd:
	# The boot unit loads kernel code: never run it as a side effect of a
	# package upgrade.
	dh_installsystemd --no-restart-after-upgrade hvpatch-boot.service
	dh_installsystemd --no-enable --no-start hvpatch-auto.timer hvpatch-auto.service
