# Build environment for pve-klp livepatch modules.
#
# The toolchain must match the shipped kernel exactly: build.sh copies the
# shipped /boot/config-<kver> into the tree, runs `make olddefconfig` and
# aborts on any difference. The config records CC_VERSION_TEXT and the
# AS/LD/PAHOLE/RUSTC/RUSTC_LLVM versions, so every tool below is pinned by
# that check. See docs/toolchains.md for the values per kernel release.
#
# Build context is this directory, with a pve-klp-tool binary next to this
# file (`make builder-image` does both). Values below are for 7.3.5-1-pve.

ARG BASE=docker.io/library/debian:trixie-20261104@sha256:bfc36aecdece0387418759dba474aa856c026ca8087da3606b41b90ab0509c99
FROM ${BASE}

# Debian main and security from one snapshot. trixie-backports from its own
# snapshot, because the kernel's rustc/LLVM pair comes from there and
# backports moves faster than the kernel series.
ARG SNAPSHOT=20261120T000000Z
ARG BACKPORTS_SNAPSHOT=20260915T000000Z
# Plain http on purpose: the base image has no CA certificates yet, and the
# InRelease files are verified with the Debian archive keys anyway.
RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && { printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s trixie main\n' "$SNAPSHOT"; \
      printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s trixie-security main\n' "$SNAPSHOT"; \
      printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s trixie-backports main\n' "$BACKPORTS_SNAPSHOT"; \
    } > /etc/apt/sources.list.d/snapshot.list

# From trixie: gcc-14 14.2.0-19, binutils 2.44, dwarves (pahole), bindgen
# (backports has none, so -t falls back to main). From trixie-backports:
# rustc, rust-src and rustfmt, which formats generated Rust bindings during
# the kernel build (7.3.x: rustc 1.94.1, LLVM 21). gawk is required by
# klp-build; qemu and busybox-static are for the QEMU stage (qemu-test.sh).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential gcc-14 binutils bc bison flex cpio kmod rsync gawk \
      libelf-dev libssl-dev libxxhash-dev libdw-dev dwarves zstd xz-utils \
      git git-buildpackage quilt devscripts ca-certificates curl gnupg python3 \
      qemu-system-x86 busybox-static \
 && apt-get install -y --no-install-recommends -t trixie-backports \
      rustc rust-src rustfmt bindgen \
 && rm -rf /var/lib/apt/lists/*

# Proxmox repository, only to download the shipped kernel and headers
# packages (fetch-shipped.sh). Low pin priority: it never replaces any
# toolchain package.
ARG PVE_COMPONENT=pve-no-subscription
ARG PVE_KEYRING_URL=https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg
ARG PVE_KEYRING_SHA256=136673be77aba35dcce385b28737689ad64fd785a797e57897589aed08db6e45
RUN curl -fsSL "$PVE_KEYRING_URL" -o /usr/share/keyrings/proxmox-archive-keyring.gpg \
 && echo "$PVE_KEYRING_SHA256  /usr/share/keyrings/proxmox-archive-keyring.gpg" | sha256sum -c - \
 && printf 'deb [signed-by=/usr/share/keyrings/proxmox-archive-keyring.gpg] http://download.proxmox.com/debian/pve trixie %s\n' "$PVE_COMPONENT" \
      > /etc/apt/sources.list.d/pve.list \
 && printf 'Package: *\nPin: origin download.proxmox.com\nPin-Priority: 100\n' > /etc/apt/preferences.d/pve

COPY pve-klp-tool /usr/local/bin/pve-klp-tool
COPY *.sh /opt/pve-klp/builder/
WORKDIR /work
