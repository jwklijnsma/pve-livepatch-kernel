[Unit]
Description=Apply new kernel livepatch levels (pve-klp)
Documentation=https://github.com/prepaid-host/pve-klp
Wants=network-online.target
After=network-online.target pve-klp-boot.service
ConditionPathIsDirectory=/sys/kernel/livepatch

[Service]
Type=oneshot
ExecStart=/usr/sbin/pve-klp --quiet apply --timer
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
