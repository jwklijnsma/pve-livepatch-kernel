[Unit]
Description=Reload kernel livepatch for the running kernel (hvpatch)
Documentation=https://github.com/prepaid-host/hvpatch man:hvpatch(8)
After=local-fs.target systemd-modules-load.service
# Patch the host before guests and the HA stack start. Ordering only: a
# failure here never blocks guests.
Before=pve-guests.service pve-ha-lrm.service
ConditionPathIsDirectory=/sys/kernel/livepatch

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/hvpatch --quiet boot
TimeoutStartSec=15min
# Same sandbox as hvpatch-auto.service, so hooks behave the same in both.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
# /etc is read-only above, except the cluster-wide lock in pmxcfs ("-": the
# path only exists on Proxmox VE nodes).
ReadWritePaths=-/etc/pve/priv/lock

[Install]
WantedBy=multi-user.target
